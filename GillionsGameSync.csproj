<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.31.10</Version>
    <DefineConstants Condition="'$(GillionsTestBuild)' != 'true'">$(DefineConstants);GILLIONS_PUBLIC_BUILD</DefineConstants>
    <AssemblyName>GillionsGameSync</AssemblyName>
    <RootNamespace>GillionsGameSync</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**;artifacts/**</DefaultItemExcludes>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Author>Gillions</Author>
    <Name>Gillions Game Sync</Name>
    <Punchline>Opt-in account sync for your Gillions profile.</Punchline>
    <Description>Opt-in character synchronization for Gillions with read-only Retainer observations. Never automates gameplay or sends Square Enix credentials.</Description>
    <ApplicableVersion>any</ApplicableVersion>
    <GillionsPublicBaseUrl Condition="'$(GillionsPublicBaseUrl)' == '' and '$(GillionsTestBuild)' == 'true'">https://test.gillions.app</GillionsPublicBaseUrl>
    <GillionsPublicBaseUrl Condition="'$(GillionsPublicBaseUrl)' == ''">https://gillions.app</GillionsPublicBaseUrl>
    <GillionsRepositoryUrl Condition="'$(GillionsRepositoryUrl)' == ''">https://github.com/anndrox/GillionsGameSync</GillionsRepositoryUrl>
    <GillionsStableIconUrl Condition="'$(GillionsStableIconUrl)' == ''">https://raw.githubusercontent.com/anndrox/GillionsGameSync/main/assets/GillionsGameSync-icon-v4.png</GillionsStableIconUrl>
    <XivpfContributionUrl Condition="'$(XivpfContributionUrl)' == '' and '$(GillionsTestBuild)' != 'true'">https://test.gillions.app/api/game-sync/party-finder/contribute</XivpfContributionUrl>
    <XivpfContributionUrl Condition="'$(XivpfContributionUrl)' == '' and '$(GillionsTestBuild)' == 'true'">https://test.gillions.app/api/game-sync/party-finder/contribute</XivpfContributionUrl>
    <RepositoryUrl>$(GillionsRepositoryUrl)</RepositoryUrl>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RepoUrl>$(GillionsRepositoryUrl)</RepoUrl>
    <IconUrl>$(GillionsStableIconUrl)</IconUrl>
    <Tags>inventory;collection;utility</Tags>
    <DalamudApiLevel>15</DalamudApiLevel>
    <LoadRequiredState>0</LoadRequiredState>
    <LoadSync>false</LoadSync>
    <CanUnloadAsync>false</CanUnloadAsync>
    <!-- Keep useful file/line diagnostics without embedding the developer's
         local workspace path in distributed assemblies. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/GillionsGameSync</PathMap>
    <!-- The SDK's built-in SourceLink embeds the git commit and the local
         checkout path in the embedded PDB, so identical code built from the
         reviewed branch and from its merge commit differed byte for byte (and
         leaked the workspace path). The release record pins the commit instead. -->
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets/GillionsGameSync-icon-v4.png" LogicalName="GillionsGameSync.Branding.png" />
    <Compile Remove="tests\**\*.cs" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GillionsPublicBaseUrl</_Parameter1>
      <_Parameter2>$(GillionsPublicBaseUrl)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>XivpfContributionUrl</_Parameter1>
      <_Parameter2>$(XivpfContributionUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <!-- A separate Dalamud identity keeps the test repository from updating or
       sharing configuration with the stable member plugin. -->
  <PropertyGroup Condition="'$(GillionsTestBuild)' == 'true'">
    <Version>0.0.106.0</Version>
    <AssemblyName>GillionsGameSyncTest</AssemblyName>
    <Name>Gillions Game Sync Testing</Name>
    <Punchline>Opt-in experimental Gillions Game Sync.</Punchline>
    <Description>Experimental read-only Gillions Game Sync. Separate TEST pairing only; keep Public disabled while Testing is enabled.</Description>
    <DefineConstants>$(DefineConstants);GILLIONS_TEST_BUILD</DefineConstants>
    <!-- The separately installed Testing product has a dedicated public
         distribution repository. Stable never selects this product's feed. -->
    <RepoUrl>$(GillionsRepositoryUrl)</RepoUrl>
    <IconUrl>$(GillionsStableIconUrl)</IconUrl>
  </PropertyGroup>
  <!-- A95: per-family native fingerprints, computed from the reviewed file sets in
       native-fingerprints.txt. CRLF is normalized so every checkout agrees. -->
  <UsingTask TaskName="GillionsNativeFingerprints" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Root ParameterType="System.String" Required="true" />
      <Manifest ParameterType="System.String" Required="true" />
      <Output ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Security.Cryptography" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string Hex(byte[] bytes) => string.Concat(bytes.Select(b => b.ToString("x2")));
        var sets = File.ReadAllLines(Manifest).Select(line => line.Trim()).Where(line => line.Length > 0 && !line.StartsWith("#"))
            .Select(line => line.Split((char[])null, StringSplitOptions.RemoveEmptyEntries)).ToList();
        var core = sets.Where(set => set[0] == "core").SelectMany(set => set.Skip(1)).ToArray();
        var code = new StringBuilder("// <auto-generated/> From native-fingerprints.txt by GillionsGameSync.csproj.\nnamespace GillionsGameSync;\n\n")
            .Append("internal static class NativeFingerprints {\n")
            .Append("    internal static readonly System.Collections.Generic.IReadOnlyDictionary<string, string> ByFamily =\n")
            .Append("        new System.Collections.Generic.Dictionary<string, string>(System.StringComparer.Ordinal) {\n");
        foreach (var set in sets.Where(set => set[0] != "core").OrderBy(set => set[0], StringComparer.Ordinal)) {
            var text = new StringBuilder("family:").Append(set[0]).Append('\n');
            foreach (var file in core.Concat(set.Skip(1)).Distinct().OrderBy(file => file, StringComparer.Ordinal)) {
                var path = Path.Combine(Root, file);
                if (!File.Exists(path)) { Log.LogError("Native fingerprint file is missing: " + file); return false; }
                var bytes = File.ReadAllBytes(path);
                var normalized = new MemoryStream(bytes.Length);
                for (var i = 0; i < bytes.Length; i++) if (!(bytes[i] == 13 && i + 1 < bytes.Length && bytes[i + 1] == 10)) normalized.WriteByte(bytes[i]);
                using (var sha = SHA256.Create()) text.Append(file).Append('\n').Append(Hex(sha.ComputeHash(normalized.ToArray()))).Append('\n');
            }
            using (var sha = SHA256.Create())
                code.Append("            [\"").Append(set[0]).Append("\"] = \"").Append(Hex(sha.ComputeHash(Encoding.UTF8.GetBytes(text.ToString())))).Append("\",\n");
        }
        code.Append("        };\n}\n");
        var generated = code.ToString();
        if (!File.Exists(Output) || File.ReadAllText(Output) != generated) {
            Directory.CreateDirectory(Path.GetDirectoryName(Output));
            File.WriteAllText(Output, generated, new UTF8Encoding(false));
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="GillionsNativeFingerprints" BeforeTargets="CoreCompile">
    <GillionsNativeFingerprints Root="$(MSBuildProjectDirectory)" Manifest="$(MSBuildProjectDirectory)\native-fingerprints.txt" Output="$(IntermediateOutputPath)NativeFingerprints.g.cs" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)NativeFingerprints.g.cs" />
    </ItemGroup>
  </Target>
</Project>
