<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.30</Version>
    <AssemblyName>GillionsGameSync</AssemblyName>
    <RootNamespace>GillionsGameSync</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**;artifacts/**</DefaultItemExcludes>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Author>Gillions</Author>
    <Name>Gillions Game Sync</Name>
    <Punchline>Opt-in account sync for your Gillions profile.</Punchline>
    <Description>Opt-in character synchronization for Gillions with read-only Retainer observations. Never automates gameplay or sends Square Enix credentials.</Description>
    <ApplicableVersion>any</ApplicableVersion>
    <GillionsPublicBaseUrl Condition="'$(GillionsPublicBaseUrl)' == ''">https://gillions.app</GillionsPublicBaseUrl>
    <GillionsRepositoryUrl Condition="'$(GillionsRepositoryUrl)' == ''">https://github.com/anndrox/GillionsGameSync</GillionsRepositoryUrl>
    <GillionsStableIconUrl Condition="'$(GillionsStableIconUrl)' == ''">https://raw.githubusercontent.com/anndrox/GillionsGameSync/main/assets/GillionsGameSync-icon-v4.png</GillionsStableIconUrl>
    <RepositoryUrl>$(GillionsRepositoryUrl)</RepositoryUrl>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RepoUrl>$(GillionsRepositoryUrl)</RepoUrl>
    <IconUrl>$(GillionsStableIconUrl)</IconUrl>
    <Tags>inventory;collection;utility</Tags>
    <DalamudApiLevel>15</DalamudApiLevel>
    <LoadRequiredState>0</LoadRequiredState>
    <LoadSync>false</LoadSync>
    <CanUnloadAsync>false</CanUnloadAsync>
    <!-- Keep useful file/line diagnostics without embedding the developer's
         local workspace path in distributed assemblies. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/GillionsGameSync</PathMap>
  </PropertyGroup>
  <!-- Local read-only runtime proof, never a feed/release build. Same Testing DLL identity. -->
  <PropertyGroup Condition="'$(GillionsAppearanceProofOnly)' == 'true'">
    <DefineConstants>$(DefineConstants);GILLIONS_APPEARANCE_PROOF_ONLY</DefineConstants>
  </PropertyGroup>
  <Target Name="ValidateAppearanceProofBuild" BeforeTargets="CoreCompile" Condition="'$(GillionsAppearanceProofOnly)' == 'true'">
    <Error Condition="'$(GillionsTestBuild)' != 'true'" Text="Appearance proof-only builds require the Testing product." />
  </Target>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GillionsAppearanceProofOnly</_Parameter1>
      <_Parameter2>$(GillionsAppearanceProofOnly)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>GillionsPublicBaseUrl</_Parameter1>
      <_Parameter2>$(GillionsPublicBaseUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <!-- A separate Dalamud identity keeps the test repository from updating or
       sharing configuration with the stable member plugin. -->
  <PropertyGroup Condition="'$(GillionsTestBuild)' == 'true'">
    <Version>0.0.1</Version>
    <AssemblyName>GillionsGameSyncTest</AssemblyName>
    <Name>Gillions Game Sync Testing</Name>
    <Punchline>Unreleased Gillions sync test build.</Punchline>
    <DefineConstants>$(DefineConstants);GILLIONS_TEST_BUILD</DefineConstants>
    <!-- The separately installed testing product remains on the private Gillions
         testing feed. Stable GitHub distribution does not publish test builds. -->
    <RepoUrl>$(GillionsPublicBaseUrl)</RepoUrl>
    <IconUrl>$(GillionsPublicBaseUrl)/downloads/plugins/GillionsGameSync-icon-v4.png</IconUrl>
  </PropertyGroup>
  <!-- Apply proof labeling after the ordinary Testing product's metadata. -->
  <PropertyGroup Condition="'$(GillionsAppearanceProofOnly)' == 'true'">
    <Punchline>Local appearance proof only. Network disabled.</Punchline>
    <Description>Read-only local character appearance capture. No pairing, uploads, configuration or game writes.</Description>
  </PropertyGroup>
</Project>
